module

public import GameTheory.Math.FiniteChoice
public import Mathlib.Data.Fintype.Powerset
public import Mathlib.Algebra.BigOperators.Group.Finset.Basic

@[expose] public section

namespace GameTheory.Experimental.ContractChoice

open GameTheory.Math
open scoped BigOperators

/-- Retain the two highest-weight contracts when all three are offered. -/
def quotaFinset (offered : Finset (Fin 3)) : Finset (Fin 3) :=
  if 0 ∈ offered ∧ 1 ∈ offered then offered.erase 2 else offered

def contractWeight (contract : Fin 3) : ℕ :=
  if contract = 0 then 4 else if contract = 1 then 2 else 1

def quotaScore (bundle : Finset (Fin 3)) : ℕ :=
  ∑ contract ∈ bundle, contractWeight contract

/-- Available alternatives are whole bundles satisfying the quota. -/
def bundleMenu (offered : Finset (Fin 3)) : Finset (Finset (Fin 3)) :=
  offered.powerset.filter fun bundle => bundle.card ≤ 2

set_option maxRecDepth 2048 in
private theorem quota_best_membership : ∀ offered chosen : Finset (Fin 3),
    (chosen ∈ bundleMenu offered ∧
      ∀ alternative ∈ bundleMenu offered, quotaScore alternative ≤ quotaScore chosen) ↔
      chosen = quotaFinset offered := by
  decide

/-- The accepted contract bundle is the unique best alternative among the
quota-feasible bundles. This does not take a union of tied alternatives. -/
theorem quota_bundle_rationalization (offered : Finset (Fin 3)) :
    FiniteChoice.best (fun chosen alternative => quotaScore alternative ≤ quotaScore chosen)
      (bundleMenu offered) = {quotaFinset offered} := by
  ext chosen
  exact quota_best_membership offered chosen

/-- Rationalization satisfies WARP on arbitrary menus of bundle alternatives,
not only the menus generated by offered contracts. -/
theorem quota_bundle_weakAxiom :
    FiniteChoice.WeakAxiom
      (FiniteChoice.best (fun chosen alternative => quotaScore alternative ≤ quotaScore chosen)) :=
  FiniteChoice.best_weakAxiom (fun _ _ _ first second => second.trans first)

theorem quota_empty_offer_selects_empty_bundle :
    (∅ : Finset (Fin 3)) ∈
      FiniteChoice.best (fun chosen alternative => quotaScore alternative ≤ quotaScore chosen)
        (bundleMenu ∅) := by
  rw [quota_bundle_rationalization]
  simp [quotaFinset]

/-- Neither contract is desirable on its own; together they form a valuable
bundle. The accepted bundle is still one alternative in the bundle menu. -/
def complementFinset (offered : Finset Bool) : Finset Bool :=
  if false ∈ offered ∧ true ∈ offered then offered else ∅

def complementScore (bundle : Finset Bool) : ℕ :=
  if bundle = ∅ then 1 else if false ∈ bundle ∧ true ∈ bundle then 2 else 0

set_option maxRecDepth 2048 in
private theorem complement_best_membership : ∀ offered chosen : Finset Bool,
    (chosen ∈ offered.powerset ∧
      ∀ alternative ∈ offered.powerset,
        complementScore alternative ≤ complementScore chosen) ↔
      chosen = complementFinset offered := by
  decide

theorem complement_bundle_rationalization (offered : Finset Bool) :
    FiniteChoice.best
      (fun chosen alternative => complementScore alternative ≤ complementScore chosen)
      offered.powerset = {complementFinset offered} := by
  ext chosen
  exact complement_best_membership offered chosen

theorem complement_bundle_weakAxiom :
    FiniteChoice.WeakAxiom
      (FiniteChoice.best
        (fun chosen alternative => complementScore alternative ≤ complementScore chosen)) :=
  FiniteChoice.best_weakAxiom (fun _ _ _ first second => second.trans first)

theorem complement_empty_offer_selects_empty_bundle :
    (∅ : Finset Bool) ∈
      FiniteChoice.best
        (fun chosen alternative => complementScore alternative ≤ complementScore chosen)
        (∅ : Finset Bool).powerset := by
  rw [complement_bundle_rationalization]
  simp [complementFinset]

end GameTheory.Experimental.ContractChoice
