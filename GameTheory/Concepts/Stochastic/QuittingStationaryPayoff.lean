import GameTheory.Concepts.Stochastic.QuittingStationaryLiveMass

/-!
# Closed-form payoff of an absorbing stationary quitting profile

The finite root payoff separates into two terms: the expected terminal reward
generated by a nonempty quitter set at the root, and the all-continue mass
times the declared continuation value.  Combining this affine decomposition
with the stationary terminal-payoff fixed point gives an exact balance law.

When the stationary all-continue probability `q` is strictly below one, the
terminal payoff is therefore the one-stage absorbing contribution divided by
`1 - q`.  This is only a stationary-profile calculation; it makes no claim
about compactness or extraction from nonstationary profiles.
-/

noncomputable section

namespace GameTheory

open StochasticGame Math.Probability Math.PMFProduct

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- Expected one-stage terminal reward, assigning payoff zero to the
all-continue root action. -/
def quittingRootAbsorbingContribution
    (reward : {S : Finset ι // S.Nonempty} → Payoff ι)
    (root : ι → PMF Bool) (who : ι) : ℝ :=
  quittingRootExpectedPayoff reward (0 : Payoff ι) root who

omit [DecidableEq ι] in
/-- The continuation enters the finite root payoff linearly, with coefficient
equal to the all-continue probability. -/
theorem quittingRootExpectedPayoff_eq_absorbingContribution_add
    (reward : {S : Finset ι // S.Nonempty} → Payoff ι)
    (continuation : Payoff ι) (root : ι → PMF Bool) (who : ι) :
    quittingRootExpectedPayoff reward continuation root who =
      quittingRootAbsorbingContribution reward root who +
        quittingStationaryContinueMass root * continuation who := by
  classical
  calc
    quittingRootExpectedPayoff reward continuation root who =
        expect (pmfPi root) (fun action =>
          quittingRootPayoff reward (0 : Payoff ι) action who +
            continuation who *
              (if action = (quittingAllContinueAction : ι → Bool)
                then 1 else 0)) := by
      unfold quittingRootExpectedPayoff
      apply congrArg (expect (pmfPi root))
      funext action
      by_cases hquit : (quittingQuitters action).Nonempty
      · have hne :
            action ≠ (quittingAllContinueAction : ι → Bool) := by
          intro heq
          subst action
          simp at hquit
        simp [quittingRootPayoff, hquit, hne]
      · have heq :=
          eq_quittingAllContinueAction_of_quittingQuitters_not_nonempty
            action hquit
        subst action
        simp [quittingRootPayoff]
    _ = quittingRootAbsorbingContribution reward root who +
        continuation who *
          expect (pmfPi root) (fun action =>
            if action = (quittingAllContinueAction : ι → Bool)
              then 1 else 0) := by
      rw [expect_add, expect_const_mul]
      rfl
    _ = quittingRootAbsorbingContribution reward root who +
        continuation who * quittingStationaryContinueMass root := by
      rw [← Math.Probability.apply_toReal_eq_expect_indicator]
      rfl
    _ = quittingRootAbsorbingContribution reward root who +
        quittingStationaryContinueMass root * continuation who := by
      ring

omit [DecidableEq ι] in
/-- A stationary terminal payoff satisfies the affine one-stage fixed-point
equation. -/
theorem quittingTerminalPayoff_stationary_affine
    (reward : {S : Finset ι // S.Nonempty} → Payoff ι)
    (root : ι → PMF Bool) (who : ι) :
    quittingTerminalPayoff reward
        (quittingStationaryProfile reward root) who =
      quittingRootAbsorbingContribution reward root who +
        quittingStationaryContinueMass root *
          quittingTerminalPayoff reward
            (quittingStationaryProfile reward root) who := by
  classical
  calc
    quittingTerminalPayoff reward
        (quittingStationaryProfile reward root) who =
      quittingRootExpectedPayoff reward
        (fun player => quittingTerminalPayoff reward
          (quittingStationaryProfile reward root) player)
        root who :=
      quittingTerminalPayoff_stationary_eq_rootExpectedPayoff
        reward root who
    _ = quittingRootAbsorbingContribution reward root who +
        quittingStationaryContinueMass root *
          quittingTerminalPayoff reward
            (quittingStationaryProfile reward root) who := by
      simpa using
        (quittingRootExpectedPayoff_eq_absorbingContribution_add
          reward
          (fun player => quittingTerminalPayoff reward
            (quittingStationaryProfile reward root) player)
          root who)

omit [DecidableEq ι] in
/-- Rearranged stationary payoff balance law. -/
theorem one_sub_continueMass_mul_quittingTerminalPayoff_stationary
    (reward : {S : Finset ι // S.Nonempty} → Payoff ι)
    (root : ι → PMF Bool) (who : ι) :
    (1 - quittingStationaryContinueMass root) *
        quittingTerminalPayoff reward
          (quittingStationaryProfile reward root) who =
      quittingRootAbsorbingContribution reward root who := by
  have haffine := quittingTerminalPayoff_stationary_affine reward root who
  linarith

omit [DecidableEq ι] in
/-- Closed form in the absorbing stationary regime `q < 1`. -/
theorem quittingTerminalPayoff_stationary_eq_absorbingContribution_div
    (reward : {S : Finset ι // S.Nonempty} → Payoff ι)
    (root : ι → PMF Bool) (who : ι)
    (hquit : quittingStationaryContinueMass root < 1) :
    quittingTerminalPayoff reward
        (quittingStationaryProfile reward root) who =
      quittingRootAbsorbingContribution reward root who /
        (1 - quittingStationaryContinueMass root) := by
  have hdenom : 1 - quittingStationaryContinueMass root ≠ 0 :=
    ne_of_gt (sub_pos.mpr hquit)
  apply (eq_div_iff hdenom).2
  simpa [mul_comm] using
    (one_sub_continueMass_mul_quittingTerminalPayoff_stationary
      reward root who)

end GameTheory
