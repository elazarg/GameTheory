{
  "schema": "quitting-table-cegis/v1",
  "gap": "1/20",
  "base_table": "../tables/fixed_gap_template_base.json",
  "variables": [
    {
      "quitters": [0, 1],
      "player": 0,
      "values": ["-2", "1"]
    }
  ],
  "max_candidates": 10,
  "search": {
    "probabilities": ["0", "1/2", "2/3", "1"],
    "max_cutoff_roots": 100,
    "max_stationary_roots": 100,
    "max_pair_roots": 100,
    "max_period": 2,
    "max_word_roots": 4,
    "max_words": 100,
    "include_hints": true
  }
}
