meta import Lean.Elab.Command

@[expose] public section

/-! Check all authored declarations, including private definitions and dependencies. -/

open Lean in
run_cmd do
  let env ← getEnv
  let allowed := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut checked : Nat := 0
  for (name, _) in env.constants.toList do
    let owned := match env.getModuleIdxFor? name with
      | some idx => (`GameTheory).isPrefixOf env.header.moduleNames[idx.toNat]!
      | none => false
    if owned then
      checked := checked + 1
      for axiomName in (← collectAxioms name) do
        unless allowed.contains axiomName do
          throwError "{name} depends on forbidden axiom {axiomName}"
  if checked == 0 then
    throwError "Axiom audit found no declarations"
